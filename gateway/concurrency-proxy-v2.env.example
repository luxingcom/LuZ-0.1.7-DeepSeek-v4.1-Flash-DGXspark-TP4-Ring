# concurrency-proxy-v2 — configuration example
# Copy to a real env file / unit Environment= lines. Every knob has a safe default;
# uncomment only what you need to change.

# --- Core wiring -----------------------------------------------------------
# Upstream inference engine (OpenAI-compatible). Loopback default.
UPSTREAM=http://127.0.0.1:8002
# Gateway listen port (clients point here).
PORT=8001
# Admission slots. Requests beyond this wait up to QUEUE_TIMEOUT, then 429.
MAX_CONCURRENCY=6

# --- Admission / timeouts (seconds) ---------------------------------------
# Max wait for an admission slot before 429 + Retry-After.
# Production note: 20 (default) fits interactive fleets; a tighter 5 bounds
# queue shadows at the cost of earlier client-visible rejections. Choose by
# your SLO, not by default.
#QUEUE_TIMEOUT=20
# Time to first upstream byte (connect + first read share this budget).
# Must exceed your worst-case prefill, or long-context requests get killed.
#FIRST_TOKEN_TIMEOUT=600
# Max silence between upstream chunks after the first byte.
#CHUNK_IDLE_TIMEOUT=180
# Max single write to the client (slow-reader protection; also wraps the
# final write_eof drain so a stalled client cannot leak the admission slot).
#WRITE_TIMEOUT=60
# Hard cap on a stream's total lifetime.
#TOTAL_STREAM_TIMEOUT=7200
# Cap for non-streaming (buffered) requests end to end.
#NONSTREAM_TOTAL_TIMEOUT=900

# --- Behavior --------------------------------------------------------------
# SSE heartbeat interval (`: keepalive` comment frames keep clients alive
# through minute-scale prefills).
#HEARTBEAT_INTERVAL=5
# Internal connect retries on 5xx before surfacing an error frame.
#RETRY_CONNECT=1
# Suppress exact-duplicate in-flight requests (same body hash -> 429 instead
# of a second full prefill). 1 = on, 0 = off.
#DEDUP_ENABLE=1

# --- Security --------------------------------------------------------------
# Bearer key for /gw/* management endpoints (health, metrics). UNSET = these
# endpoints are open -- acceptable only for loopback-only deployments.
# Generate e.g. with: openssl rand -hex 32
#GW_API_KEY=

# --- Optional request transformation ---------------------------------------
# 1 = inject chat_template_kwargs.enable_thinking=true into POST
# chat/responses bodies that do not mention the key (dedup keys are computed
# after injection, so they stay stable). 0 = off, zero behavior change.
#INJECT_ENABLE_THINKING=0

# --- Logging ---------------------------------------------------------------
#LOG_LEVEL=INFO
