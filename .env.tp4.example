# 4x DGX Spark profile (TP4). Copy to .env.tp4 and edit. Never commit .env.tp4.
# Loaded by ./start-tp4.sh, and by ./start.sh as well whenever it finds this file
# -- the 4-Spark TP4 profile is the default. Pass ENV_FILE=.env explicitly to get
# the legacy 3-Spark dev profile instead. (See start.sh's "Profiles:" block.)
#
# 本文件是 **0.2.9 定板生产 `.env.tp4` 的公开模板**：除约 20 个站点相关键（节点 IP /
# 主机名 / 用户 / 模型路径 / PEER_HCA 与 B12X 布线）以占位符替代外，其余键**逐值等同**。
# 逐项对照与差异来源见 [docs/CONFIG-v0.2.8-ENV.md](docs/CONFIG-v0.2.8-ENV.md)（0.2.8 基线）
# 与 [docs/release-notes/RELEASE-NOTES-v0.2.9.md §3](docs/release-notes/RELEASE-NOTES-v0.2.9.md)
# （0.2.9 逐键 diff：顶层 3 项 + EXTRA_DOCKER_ENV 30 项）。
#
# ⚠ `IMAGE` 已随本版推进到 0.2.9：照本模板起栈得到的是 **0.2.9 形态**。这与
#   README §7 的当前发布件一致（0.2.9 包 SHA256/MD5/identity 见该节）。
#   0.2.8 的键集仍是历史形态，需要时用 `git show` 取对应版本的模板。
#
# 同步纪律（review finding R4-F4）：生产加一个旋钮而模板没跟，fresh deployment 就会
# **静默丢掉**那项优化。所以改生产 `.env.tp4` 时必须在**同一提交内**改这里。
# ⚠ 上一代的生成脚本（`evidence/delivery-*/gen_env_example.py`）不在公开仓内；本模板
#   自 0.2.8 起以「人工同步 + docs/CONFIG-v0.2.8-ENV.md 逐键对照表」作为校验面。
# ⚠ 下面 4 行是**占位符，不是可用值** —— 必须按你自己的集群改。
#   尖括号 + 引号是刻意的：漏改时 ssh 立刻报 "Could not resolve hostname
#   <head-node-ip>"；若沿用旧的内网示例地址，失败会发生在更靠后的位置、
#   更难归因。引号不可去 —— shell 会把裸尖括号当重定向，source 直接语法错误。
#   顺序有意义：WORKER_IPS / WORKER_HOSTS 里的第 N 个 = rank N（即第 1 个是 rank1）。
HEAD_IP="<head-node-ip>"
WORKER_IPS="<worker-rank1-ip> <worker-rank2-ip> <worker-rank3-ip>"
WORKER_HOSTS="<worker-rank1-ssh-name> <worker-rank2-ssh-name> <worker-rank3-ssh-name>"
WORKER_USER="<your-ssh-user>"
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# ─── fabric ──────────────────────────────────────────────────────────────────
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
# 调试期开关，交付前关闭：曾设 NCCL_DEBUG=INFO + SUBSYS=INIT,ENV，配套 EXTRA_DOCKER_ENV 的
# NCCL_DEBUG_FILE 写 /nccl-debug（RW 挂进四机生产容器，随每次容器启动增长）。关掉后由
# start.sh 默认值接管（NCCL_DEBUG=WARN / NCCL_DEBUG_SUBSYS=INIT）。
# 注意 nccl_selfcheck.sh 的语义：WARN（默认）下它判定"不适用"并跳过；设成其它值才真校验，
# 且要求调试日志**是本次靴产生的**（NCCL_SELFCHECK_MAX_AGE，默认 3600s）。
# NCCL_DEBUG=INFO
# NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly
NCCL_BUFFSIZE=8388608
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
# 环网铁律：GID 索引必须在四机上一致，且**不是 -1**（禁用 RoCE 会直接掉回 socket 路径）。
# 本模板传 FORCE=3；容器内实测解析结果为 NCCL_IB_GID_INDEX=3。
NCCL_IB_GID_INDEX_FORCE=3

# per-rank PEER_HCA -- which local HCA pair reaches which peer rank.
#
# The concrete pinning is deliberately NOT published. On a 4-node ring it encodes
# the physical cabling -- which port of which node joins which two peers -- and that
# is the one thing about this fabric that is not generic.
#
# Derive it for your own ring, once, from a first boot:
#   1. start with NCCL_DEBUG=INFO and read "NET/IB/<idx>=<hca>" per rank;
#   2. the pair listed for a peer rank is that peer's HCA pair, so translate the
#      index back to the peer's rank number and fill <PINNING> as "<peer>=<hcaA>,<hcaB>";
#   3. each rank needs an entry for each peer it actually talks to -- for a TP4 ring
#      that is its two ring neighbours, i.e. two pairs per rank.
# `./start-tp4.sh ncclcheck` verifies the result: with a correct map the log shows
# the ring channels only, with no socket fallback.
PEER_HCA_RANK0="<PINNING>"
PEER_HCA_RANK1="<PINNING>"
PEER_HCA_RANK2="<PINNING>"
PEER_HCA_RANK3="<PINNING>"

# static ring NCCL + general env, appended last so it wins duplicates.
#
# ⚠ 这一行是**行为相关键的唯一通路**：start.sh 只把白名单内的顶层变量透传进容器，
#   其余顶层键（含 DSV41_*）**静默丢弃**（仅打一行 warn）。凡是要进容器的键都必须
#   写在 EXTRA_DOCKER_ENV 里 —— 写成独立顶层行 = 死配置（本模板 0.2.7 及更早
#   版本就踩过这个坑，见下方 "DSV41_PREFILL_EMPTY_CACHE_TOKENS" 处的注记）。
#
# 0.2.8 定板生产（.env.tp4, md5 3f6a014d）在本行并入的、相对基座新增的 8 项：
#   DSV41_IDLE_RELEASE=1                  FIX-B 空闲窗释放（镜像缺省 0）
#   DSV41_SCHED_SNAPSHOT=1                FIX-B′ SIGUSR1 内存快照钩子（诊断项，缺省 0）
#   DSV41_IDX_PROTOCOL=1                  #40352 候选块协议（缺省 0）—— 256K/512K 单流存活开关
#   DSV41_PREFILL_SHARE_TOKENS=4096       scheduler prefill share cap（#34554）
#   DSV41_PREFILL_EMPTY_CACHE_TOKENS=0    长 prefill 的 chunk 间瞬时内存归还：定板为 0
#   SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0
#   SGLANG_DSV4_PAGETABLE_PAGES_GRID=1    R2 page-table 网格 **关闭**
#                                         （注意 =1 表示"网格关"，非"网格在"；
#                                          定板延续 2026-09-22 阶梯窗的既有决定）
#   DSV41_DENSE_INDEXER_LOGITS_BUDGET_BYTES=134217728   （见下方预算注记）
#
# 2026-09-16 步骤 4（单变量）：拧紧 dense indexer 的 logits row-chunk 预算。
#   1<<31(2GiB, 历史值) → 1<<29(512MiB) → **1<<27(128MiB, 2026-09-23 定板值)**。
#   默认(不设)=1<<31 ⇒ 本行删掉即回退。
#   为什么：该层 seq_len//ratio(ratio=1 层有 20 层) 就是 lc，是**整段前缀**（245.7K prompt
#   ⇒ lc=245760）。logits 张量 [chunk_rows, lc] fp32，其**峰值恒等于预算本身**
#   （rows_per_chunk = budget//(lc_aligned*4)）⇒ 每降一档把瞬态峰按比例砍。
#   社区对照：sglang #36941（2×GB10）强制 512-row logits 分块把 >300s 超时变成 135s PASS。
#   只影响长前缀 prefill（lc 大时才会分块）；decode/short-prefill 的 lc 小 ⇒ 单趟不变。
EXTRA_DOCKER_ENV="NCCL_ALGO=RING NCCL_IB_TIMEOUT=1000 NCCL_IB_RETRY_CNT=7 NCCL_IB_TOS=46 NCCL_IGNORE_CPU_AFFINITY=1 NCCL_MIN_NCHANNELS=4 NCCL_SET_THREAD_NAME=1 NCCL_NET_PLUGIN=none NCCL_TUNER_THRESHOLD=40960 NCCL_CUMEM_HOST_ENABLE=0 TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_DISABLE_VERSION_CHECK=1 PYTHONFAULTHANDLER=1 HF_HUB_OFFLINE=1 DSV41_SHARED_PAD_K=1 EP_SUPPRESS_NCCL_CHECK=1 SGLANG_RAGGED_VERIFY_MODE=static MALLOC_ARENA_MAX=2 DSV41_MOE_B12X=0 DSV41_MOE_B12X_CAPS=128,256,512,1024,2304,4096 DSV41_MOE_B12X_QUANT=a8 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_SKIP_NONFINAL_DECODER=1 SGLANG_QW3_DSPARK_LAUNCH_PARAMS=1 SGLANG_DSV4_KV_LAYOUT=fork-v4-fp4 DSV41_DENSE_INDEXER_LOGITS_BUDGET_BYTES=536870912 DSV41_PREFILL_SHARE_TOKENS=4096 DSV41_PREFILL_EMPTY_CACHE_TOKENS=0 SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0 DSV41_IDX_PROTOCOL=1 DSV41_IDLE_RELEASE=1 DSV41_SCHED_SNAPSHOT=1 SGLANG_DSV4_PAGETABLE_PAGES_GRID=1 DSV41_VERIFY_PRUNE=0 DSV41_VERIFY_PRUNE_LOG=1 DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_FOLDED_FENCE=1 DSV41_LOOP_ABORT=0 DSV41_L2_PREFETCH=1 DSV41_EAGER_GLUE=all DSV41_VERIFY_CAP=conf:0.1 DSV41_ROUTER_LIVE=1 DSV41_SPEC_SYNC_FREE=all DSV41_ROCE_RING=1 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=2097152 DSV41_ROCE_GATHER=524288 B12X_ROCE_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1 B12X_ROCE_PEER_HCA_MAPS=<PINNING> B12X_ROCE_TWO_WAVE_THRESHOLD_BYTES=0 DSV41_SPARK_PREFILL_TP_SPLIT=1 DSV41_LAUNCHER=tp4 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_HC_FUSED=1"
# 2026-09-16 W8: 删两个「设置了但不在路径上」的 flag（项 3，源码级已证死）：
#   SGLANG_OPT_DSV4_NONPAGED_INDEXER_MIN_QUERY_TOKENS=4096
#     _get_nonpaged_indexer_plan 只被 C4Indexer 调（dsv4_indexer.py:825），
#     而 C4Indexer 只在 compress_ratio==4 时构造；本模型 compress_ratios={0:5,2:18,1:20}
#     ⇒ 无 ratio-4 层 ⇒ 任何 chunk 尺寸下都不生效。
#   --deepseek-v4-prefill-reuse uniform-w4
#     maybe_apply_reuse 的唯一调用点在同一死分支内（dsv4_indexer.py:906）。
#   两者都属 #38979（uniform-w4 是 leader-row 广播的预设名）被挂错分支的产物；
#   真正的 dense 低比打分路径是 _low_ratio_index_topk_dense（当前全量打分、零复用），
#   要拿增益须改挂到那里并做 A/B —— 那是独立立项，不是「保留两个死 flag」。

# ─── model / image ───────────────────────────────────────────────────────────
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
# 生产 pin。**模板值必须跟随生产 pin**：换生产版本时要同时改这里、`.env.tp4`、
# 以及守卫的 `sglang-image` envpin（三处不一致时 preflight 会拦）。
# 2026-09-23 修：本行曾是 v7（0.1.7 / 125 层，落后三代）——照模板起栈会静默拉远古镜像，
# 且这种不一致**没有任何告警面**。
# 2026-10-01 修：本行原为 0.2.8，落后于 README §7 已发布的 0.2.9 —— 部署者按 README
# 下载并加载 0.2.9 后再按模板起栈，会在 `image_preflight` 处失败，而报错点名的是一个
# 他从未下载过的镜像。**失败是 fail-closed 的（好事），但缺任何一个面都会让人先怀疑自己的加载步骤。**
IMAGE=dsv41-sglang-optimized:0.2.9-ep1q2-fin2
EXPECTED_SHARDS=48

# ─── weights: per-worker sources ─────────────────────────────────────────────
WEIGHTS_MODE=local
# fallback (worker without a per-rank override):
WORKER_MODEL_DIR=$HOME/NewModels/dsv41-net
# rank1 = spark2: full local checkpoint
WORKER_MODEL_DIR_1=$HOME/NewModels/DeepSeek-V4.1-Flash
# rank2 = spark4, rank3 = spark3: NFS view of the 46 remote shards +
# the two Engram shards pinned to the LOCAL files (never over the network)
WORKER_MODEL_DIR_2=$HOME/NewModels/dsv41-net
WORKER_MODEL_DIR_3=$HOME/NewModels/dsv41-net
ENG_SH47=$HOME/NewModels/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors
ENG_SH48=$HOME/NewModels/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors
WORKER_EXTRA_MOUNTS_2="-v $HOME/NewModels/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:ro -v $HOME/NewModels/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:ro"
WORKER_EXTRA_MOUNTS_3="-v $HOME/NewModels/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00047-of-00048.safetensors:ro -v $HOME/NewModels/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:/models/DeepSeek-V4.1-Flash/model-00048-of-00048.safetensors:ro"
NFS_SHARE=0
WORKER_DIR=$HOME/dsv41-4x-spark

# ─── parallelism ─────────────────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=1
DIST_PORT=20000

# ─── serving ─────────────────────────────────────────────────────────────────
PORT=8899
HOST=127.0.0.1
# Leave empty to auto-generate into $STATE_DIR/api-key (chmod 600).
API_KEY=
SERVED_MODEL_NAME=deepseek-v4.1-flash

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=1
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# W8 单变量（项 2b①）：V4 repack 桥的 scratch 预算。
#   512  ⇒ max_rows 917,504 ⇒ chunk 4096×topk 512 需切 3 片（现状默认）
#   4096 ⇒ 1 片（行数不变，只少 2 次 attention 重入 + 2 次 torch.cat）
# W8 结论（项 2b①）：SGLANG_DSV4_FP4_BRIDGE_SCRATCH_MB 512→4096 真能把切片
# 4313→0（实测 extra_slices=0），但端到端无可复现收益（123.4/122.1 vs
# 130.9/117.4 s，逐 seed 排序自相矛盾），却要多占最多 ~1.2 GB 显存 ⇒ **不采纳**，
# 保持默认 512。该旋钮若要用，必须放进 EXTRA_DOCKER_ENV（独立行不进容器）。
# ─── context / pool / concurrency ───────────────────────────────────────────
# 0.2.8 定板形态（.env.tp4，md5 3f6a014d，2026-09-23 起）：600K 单请求上限 × 16 路
# 满 pin = 9,600,000。与生产容器 `server_args` 实测一致：context_length=600000,
# max_total_tokens=9600000, max_running_requests=16, mem_fraction_static=0.9,
# chunked_prefill_size=8192。
# chunk 沿革：4096 是 0.2.4 世代的生产值（Form A，2026-09-17 起）；8192 于 2026-09-19
# 先作为 benchmark-only 形态验证通过，随后在 0.2.8 窗口晋升进生产 `.env.tp4` —— 它是
# 524288-token prompt 能装下的前提，也是长 prompt prefill 单流串行化的原因。
# **0.2.8 的每一格 PR 数据都在 8192 下测得**，跨窗口对照必须同档。
# 早期在本环网上的保守试跑是 256K / 2M 池，仅用于首次 boot 验证，**不是现役值**。
CONTEXT_LENGTH=600000
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_RUNNING_REQUESTS=16
CHUNKED_PREFILL_SIZE=8192
# 2026-09-16 变更 #15：NSEQ 12→16 与 pin 联立为 16×600k = 9,600,000。
# ⚠口径提醒：满并发时池余量归零（radix 缓存工作集为 0），靠 retraction_policy=length 兑底。
# ⚠地板风险：池价 0.850 GiB/M token ⇒ 8M→9.6M 从 head 地板拿走 ~1.36 GiB；
# 8M 实测最坏 eff 5.57 GiB ⇒ 9.6M 实测 ~4.2 GiB。改值必须重测地板。
MAX_TOTAL_TOKENS=9600000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
# DSPARK_BLOCK_SIZE=5 ⇒ verify = 6（引擎 side 报 speculative_num_draft_tokens=6）。
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards (pack after the first stable boot) ─────────────────
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1

# ─── container memory cap ────────────────────────────────────────────────────
# ⚠ 0.2.9 生产把 `start.sh` 的容器帽默认 24g 放宽到了 **32g**（2026-09-28 裁定），
#   理由是武装探针的 flush 峰实测 21.7G 以上。**这是与站点负载有关的放宽，不是优化，
#   本模板有意保持 24g 默认**：这道闸压住的是可回收页缓存而非 anon，而 GPU 的
#   ~99GiB 统一内存与它同池 —— 抬高上限等于让页缓存去抢 GPU 的口粮。
#   要放宽请先确认你自己的宿主水位与探针负载。详见 RELEASE-NOTES-v0.2.9 §3.1。
# CTN_MEMORY=32g
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ─────────────────────────────────────────────────
# ⚠ fp4 indexer 在 0.2.8 定板生产里是**关闭**的：下面这行**不含**
#   `--enable-deepseek-v4-fp4-indexer`（生产 .env.tp4 里的出现次数实测 = 0）。
#   沿革：Form A（2026-09-17 → 0.2.8 定板之前）曾开启该 flag；A/B（code-256，同口径）
#   测得 c1 −6.4% / c8 −0.9% / c16 −3.3%，轻微负向、当时知情保留；0.2.8 定板把它移出
#   生产形态。**形态 A / 形态 B 是两种配置，任何性能行都不得互引。**
#   ⚠ 运维禁令：若要重新开启此 flag，**必须先修 FIX-D 的 logits 宽度分桶** —— 现制在
#   2K 宽度上是 1024× 过分配（见 README §4、RELEASE-NOTES-v0.2.8 §3.1）。
#
# 0.2.8 定板在 `--min-free-slots-delay 1` 之后追加的 3 个 flag（相对 0.2.7）：
#   --prefill-decode-interval 4 / --enable-mixed-chunk / --max-queued-requests 32
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --enable-metrics --min-free-slots-delay 1 --prefill-decode-interval 4 --max-queued-requests 32 --enable-encoder-swa-bounded-replay"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
# ⚠ 0.2.7 及更早的模板在这里有一行顶层 `DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192`。
#   那是**死配置**：start.sh 只透传白名单内的顶层变量，DSV41_* 顶层键会被静默丢弃
#   （仅一行 warn）。0.2.8 定板该旋钮的值是 **0**，且**写在 EXTRA_DOCKER_ENV 内**（见上）。
#   该行已删除，以免"看起来设了 8192、实际什么都没进容器"。

# ─── TP4 runtime ─────────────────────────────────────────────────────────────
DSV41_TP_PAD=0
